//! Pest Grammar for Huff Language (with huff-neo extensions)
//! Version: 1.1
//!
//! PEG (Parsing Expression Grammar) specification for Huff Neo
//!
//! Usage with pest:
//!   #[derive(Parser)]
//!   #[grammar = "path/to/huff.pest"]
//!   struct HuffParser;
//!
//! Notes on PEG semantics used throughout:
//!   - Choices are ordered and never backtrack into a committed alternative, so longer or more
//!     specific alternatives come first.
//!   - Non-atomic rules skip WHITESPACE/COMMENT between `~` items. Tokens that must not contain
//!     whitespace or must end at a word boundary are atomic (`@{}` / `${}`).

// ============================================================================
// WHITESPACE AND COMMENTS (automatically skipped by pest)
// ============================================================================

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

// Examples:
//   // line comment
//   /* block comment /* nested */ still a comment */
COMMENT = _{ "//" ~ (!NEWLINE ~ ANY)* | block_comment }
block_comment = _{ "/*" ~ (block_comment | !"*/" ~ ANY)* ~ "*/" }

// Characters that may continue an identifier; used for word-boundary lookaheads.
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

// ============================================================================
// TOP-LEVEL CONTRACT STRUCTURE
// ============================================================================

// Example:
//   #include "lib.huff"
//   #define constant MY_CONST = 0x42
//   #define macro MAIN() = takes(0) returns(0) { ... }
contract = { SOI ~ (import_directive | definition)* ~ EOI }

// Example: #include "utils.huff"
import_directive = { "#include" ~ string_literal }

definition = {
    function_definition
    | event_definition
    | error_definition
    | constant_definition
    | macro_definition
    | table_definition
}

// ============================================================================
// ABI DEFINITIONS (functions, events, errors)
// ============================================================================

// Example: #define function transfer(address to, uint256 amount) nonpayable returns(bool)
function_definition = {
    "#define" ~ "function" ~ identifier ~ parameter_list
    ~ mutability_specifier*
    ~ ("returns" ~ parameter_list)?
}

mutability_specifier = { "view" | "pure" | "payable" | "nonpayable" }

// Example: #define event Transfer(address indexed from, address indexed to, uint256 amount)
event_definition = { "#define" ~ "event" ~ identifier ~ indexed_parameter_list }

// Example: #define error InsufficientBalance(uint256 available, uint256 required)
error_definition = { "#define" ~ "error" ~ identifier ~ parameter_list }

// Examples: (), (uint256), (address from, uint256 amount), (bytes memory data)
parameter_list = { "(" ~ (parameter ~ ("," ~ parameter)*)? ~ ")" }
parameter = { type_name ~ storage_location? ~ identifier? }

// Examples: (address indexed from, uint256 amount)
indexed_parameter_list = { "(" ~ (indexed_parameter ~ ("," ~ indexed_parameter)*)? ~ ")" }
indexed_parameter = { type_name ~ "indexed"? ~ identifier? }

storage_location = { "memory" | "storage" | "calldata" }

// Solidity type names with optional array suffixes
// Examples: uint256, address, bytes32[], uint256[][3], (address,(bool,bytes))[], MyStruct
type_name = { (elementary_type | mapping_type | tuple_type | user_defined_type) ~ array_suffix* }

// Examples: [], [5]
array_suffix = { "[" ~ decimal_literal? ~ "]" }

// Examples: address, bool, string, bytes, bytes32, uint, uint8, int256, fixed128x18
elementary_type = @{
    ( "address"
    | "bool"
    | "string"
    | ("uint" | "int" | "bytes") ~ ASCII_DIGIT*
    | ("ufixed" | "fixed") ~ (ASCII_DIGIT+ ~ "x" ~ ASCII_DIGIT+)?
    ) ~ !ident_char
}

// Example: mapping(address => uint256)
mapping_type = { "mapping" ~ "(" ~ type_name ~ "=>" ~ type_name ~ ")" }

// Examples: (address,uint256), (address,(bool,bytes))
tuple_type = { "(" ~ (parameter ~ ("," ~ parameter)*)? ~ ")" }

// Examples: MyStruct, MyContract.MyStruct
user_defined_type = { identifier ~ ("." ~ identifier)* }

// ============================================================================
// CONSTANT DEFINITIONS
// ============================================================================

// Examples:
//   #define constant MY_VALUE = 0x42
//   #define constant TOTAL = [BASE] + [OFFSET]
//   #define constant SLOT = FREE_STORAGE_POINTER()
//   #define constant SIG = __FUNC_SIG("transfer(address,uint256)")
//   #define constant GREETING = "hello"
constant_definition = { "#define" ~ "constant" ~ identifier ~ "=" ~ constant_value }

// Strings, builtins, FREE_STORAGE_POINTER() and __NOOP are whole values; they cannot be
// combined with operators. Expressions may use hex, decimal, [CONST], parentheses and operators,
// but not <arg>: constants are defined outside any macro.
// Examples: 0x42, 5, 5 + 0x10, [BASE] * 2, !0x00
constant_value = {
    free_storage_pointer
    | noop
    | string_literal
    | builtin_function_call
    | !"<" ~ expression
}

// Allocates the next free storage slot at compile time
free_storage_pointer = { "FREE_STORAGE_POINTER()" }

// Empty value: produces no bytecode
noop = @{ "__NOOP" ~ !ident_char }

// ============================================================================
// COMPILE-TIME EXPRESSIONS
// ============================================================================

// Used in: constant definitions, for-loop bounds and steps, if conditions, and parenthesized
// opcode operands. Comparisons evaluate to 1 (true) or 0 (false).
// Precedence, lowest first: comparison, additive, multiplicative, unary.
// Examples: 0x42, [BASE] + [OFFSET], 0x100 * 2 - 1, -[VALUE], ![FLAG], ([A] + [B]) > 0x20,
//           <mode> == 0x01, <i> + 17
expression = { sum ~ (comparison_op ~ sum)* }
sum = { product ~ (additive_op ~ product)* }
product = { unary ~ (multiplicative_op ~ unary)* }
unary = { unary_op ~ unary | primary }

// Two-character operators come before their one-character prefixes
comparison_op = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
additive_op = { "+" | "-" }
multiplicative_op = { "*" | "/" | "%" }
unary_op = { "-" | "!" }

// <name> is a macro parameter, or the loop variable inside the for loop that declares it
primary = {
    "(" ~ expression ~ ")"
    | constant_reference
    | argument_reference
    | hex_literal
    | decimal_literal
    | boolean_literal
}

// Example: [MY_CONSTANT]
constant_reference = { "[" ~ identifier ~ "]" }

// Example: <x>
argument_reference = { "<" ~ identifier ~ ">" }

// ============================================================================
// TABLE DEFINITIONS
// ============================================================================

// Jump tables list labels; code tables list raw bytes.
// Examples:
//   #define jumptable ROUTES { main transfer approve }
//   #define jumptable__packed PACKED_ROUTES { main transfer }
//   #define table CODE_TABLE { 0x6080 [MY_CONST] __RIGHTPAD(0x42) }
//   #define table CODE_TABLE() = { 0x6080 }
table_definition = {
    "#define" ~ ("jumptable__packed" | "jumptable") ~ identifier ~ table_suffix ~ "{" ~ identifier* ~ "}"
    | "#define" ~ "table" ~ identifier ~ table_suffix ~ "{" ~ code_table_entry* ~ "}"
}

// Optional `()` and `=` after a table name
table_suffix = { ("(" ~ ")")? ~ "="? }

code_table_entry = { hex_literal | constant_reference | builtin_function_call }

// ============================================================================
// MACRO DEFINITIONS
// ============================================================================

// macro: inlined at each call site; fn: outlined and jumped to; test: run by the test runner
// Examples:
//   #define macro MAIN() = takes(0) returns(0) { ... }
//   #define fn ADD(x, y) = takes(2) returns(1) { ... }
//   #[calldata("0x01020304"), value(0x01)] #define test MY_TEST() = { ... }
macro_definition = {
    decorator?
    ~ "#define" ~ macro_type ~ identifier ~ macro_parameters ~ "="
    ~ macro_takes? ~ macro_returns?
    ~ block
}

macro_type = { "macro" | "fn" | "test" }

// Examples: (), (x), (x, y, z)
macro_parameters = { "(" ~ (identifier ~ ("," ~ identifier)*)? ~ ")" }

// Examples: takes(2), returns(1)
macro_takes = { "takes" ~ "(" ~ decimal_literal ~ ")" }
macro_returns = { "returns" ~ "(" ~ decimal_literal ~ ")" }

// Test environment setup: calldata takes a hex string, value takes a hex literal
// Example: #[calldata("0x01020304"), value(0x0a)]
decorator = { "#[" ~ (decorator_flag ~ ("," ~ decorator_flag)*)? ~ "]" }
decorator_flag = {
    "calldata" ~ "(" ~ string_literal ~ ")"
    | "value" ~ "(" ~ hex_literal ~ ")"
}

// ============================================================================
// MACRO BODY STATEMENTS
// ============================================================================

// Body of a macro, for loop, or if/else branch
block = { "{" ~ statement* ~ "}" }

// In a macro body, true/false are pushed as 0x01/0x00 and constants use brackets: [MY_CONST]
statement = {
    label_definition
    | for_loop
    | if_statement
    | stack_immediate_statement  // dupn 17, exchange 1 2
    | push_statement             // push1 0x10, push2 [SIZE]
    | plain_opcode               // add, mstore, push0
    | hex_literal
    | boolean_literal
    | constant_reference         // [MY_CONST]
    | builtin_function_call
    | argument_invocation        // <callback>(args)
    | argument_reference         // <param>, <i>
    | noop
    | macro_invocation           // MY_MACRO(args)
    | label_reference            // my_label
}

// Jump destination; the colon must directly follow the name. Opcode names are valid labels.
// Examples: my_label:, add:
label_definition = ${ identifier ~ ":" }

// Label reference (pushes the label's offset). Opcode and builtin names are never labels.
// Example: my_label jumpi
label_reference = { !(opcode | builtin_name) ~ identifier }

// Examples:
//   MY_MACRO()
//   HELPER(0x42, <param>)
//   STORE(MY_CONSTANT, add, my_label)
macro_invocation = { !(opcode | builtin_name) ~ identifier ~ macro_arguments }

// Invocation of a macro passed as a parameter
// Example: <callback>(0x42)
argument_invocation = { argument_reference ~ macro_arguments }

macro_arguments = { "(" ~ (macro_argument ~ ("," ~ macro_argument)*)? ~ ")" }

// A bare identifier is resolved by the callee as a constant, label, or opcode, so constants are
// passed WITHOUT brackets: HELPER(MY_CONST), not HELPER([MY_CONST]).
// Decimals are converted to hex: 18 is the same as 0x12.
macro_argument = {
    hex_literal
    | decimal_literal
    | boolean_literal
    | argument_invocation    // <callback>(args)
    | argument_reference     // <param>, <i>
    | builtin_function_call  // __FUNC_SIG(transfer)
    | noop
    | macro_invocation       // NESTED_MACRO()
    | identifier             // MY_CONST, my_label, add
}

// ============================================================================
// OPCODES
// ============================================================================

// An opcode must not run into a following identifier character, so `addr` is an identifier and
// not `add` followed by `r`.
opcode = @{ opcode_inner ~ !ident_char }

// Complete list of EVM opcodes, mirroring OPCODES in crates/utils/src/opcodes.rs.
// Longest first: PEG choice is ordered, so "swap1" must not shadow "swap16", "call" not
// "callcode", "or" not "origin", and so on.
// Some opcodes require a minimum EVM version (-e/--evm-version), e.g. push0 (shanghai),
// tload/tstore/mcopy/blobhash/blobbasefee (cancun), clz (osaka), and
// slotnum/dupn/swapn/exchange (amsterdam).
opcode_inner = {
    "returndatacopy" | "returndatasize" | "calldatacopy" | "calldataload" | "calldatasize"
    | "delegatecall" | "selfdestruct" | "blobbasefee" | "extcodecopy" | "extcodehash"
    | "extcodesize" | "selfbalance" | "difficulty" | "prevrandao" | "signextend" | "staticcall"
    | "blockhash" | "callvalue" | "keccak256" | "timestamp" | "blobhash" | "callcode" | "codecopy"
    | "codesize" | "coinbase" | "exchange" | "gaslimit" | "gasprice" | "jumpdest" | "address"
    | "balance" | "basefee" | "chainid" | "create2" | "invalid" | "mstore8" | "slotnum" | "addmod"
    | "caller" | "create" | "iszero" | "mstore" | "mulmod" | "number" | "origin" | "push10"
    | "push11" | "push12" | "push13" | "push14" | "push15" | "push16" | "push17" | "push18"
    | "push19" | "push20" | "push21" | "push22" | "push23" | "push24" | "push25" | "push26"
    | "push27" | "push28" | "push29" | "push30" | "push31" | "push32" | "return" | "revert"
    | "sstore" | "swap10" | "swap11" | "swap12" | "swap13" | "swap14" | "swap15" | "swap16"
    | "tstore" | "dup10" | "dup11" | "dup12" | "dup13" | "dup14" | "dup15" | "dup16" | "jumpi"
    | "mcopy" | "mload" | "msize" | "push0" | "push1" | "push2" | "push3" | "push4" | "push5"
    | "push6" | "push7" | "push8" | "push9" | "sload" | "swap1" | "swap2" | "swap3" | "swap4"
    | "swap5" | "swap6" | "swap7" | "swap8" | "swap9" | "swapn" | "tload" | "byte" | "call" | "dup1"
    | "dup2" | "dup3" | "dup4" | "dup5" | "dup6" | "dup7" | "dup8" | "dup9" | "dupn" | "jump"
    | "log0" | "log1" | "log2" | "log3" | "log4" | "sdiv" | "sha3" | "smod" | "stop" | "add" | "and"
    | "clz" | "div" | "exp" | "gas" | "mod" | "mul" | "not" | "pop" | "sar" | "sgt" | "shl" | "shr"
    | "slt" | "sub" | "xor" | "eq" | "gt" | "lt" | "or" | "pc"
}

// An opcode used on its own. Opcodes with immediate data are only valid together with their
// operands (see stack_immediate_statement and push_statement).
plain_opcode = { !(single_stack_opcode | pair_stack_opcode | push_opcode) ~ opcode }

// Opcodes with immediate operands (EIP-8024, amsterdam). Operands are stack positions resolved
// at compile time and encoded by the compiler into the immediate byte.
// Valid ranges: dupn/swapn 17..=235, exchange n m with 1 <= n < m and n + m <= 30.
// Examples:
//   dupn 17
//   swapn [DEPTH]
//   exchange 1 <m>
//   for (i in 17..20) { dupn <i> }
//   dupn ([BASE] + 1)
stack_immediate_statement = {
    single_stack_opcode ~ opcode_operand
    | pair_stack_opcode ~ opcode_operand ~ opcode_operand
}

single_stack_opcode = @{ ("dupn" | "swapn") ~ !ident_char }
pair_stack_opcode = @{ "exchange" ~ !ident_char }

// PUSH1..PUSH32 with an explicit value. A hex literal is left-padded to the push width; any other
// operand is resolved at compile time and must fit the push width.
// Examples: push1 0x10, push32 0x108, push2 [SIZE], push1 <value>, push4 ([A] * 2)
push_statement = { push_opcode ~ opcode_operand }

push_opcode = @{ "push" ~ ("3" ~ '0'..'2' | '1'..'2' ~ ASCII_DIGIT | '1'..'9') ~ !ident_char }

// Compile-time operand of an opcode with immediate data
// Examples: 17, 0x11, [DEPTH], <depth>, <i> (loop variable), ([BASE] + 1)
opcode_operand = {
    hex_literal
    | decimal_literal
    | constant_reference
    | argument_reference
    | "(" ~ expression ~ ")"
}

// ============================================================================
// BUILTIN FUNCTIONS
// ============================================================================

// Examples:
//   __FUNC_SIG("transfer(address,uint256)")   __FUNC_SIG(transfer)
//   __EVENT_HASH(Transfer)                    __ERROR(InsufficientBalance)
//   __tablesize(MY_TABLE)                     __tablestart(MY_TABLE)
//   __codesize(MAIN)                          __codesize(RUNTIME)  // MAIN + appended tables
//   __EMBED_TABLE(MY_TABLE)
//   __RIGHTPAD(0x42)                          __RIGHTPAD(__FUNC_SIG("transfer(address,uint256)"))
//   __LEFTPAD([ADDRESS])                      __VERBATIM(0x1234)
//   __BYTES("hello")                          __BYTES([GREETING])
//   __ASSERT_PC([TARGET_PC])                  __CODECOPY_DYN_ARG(0x00, 0x20)
// __LEFTPAD is only valid in constant definitions and code tables. A builtin used as the
// argument of __RIGHTPAD/__LEFTPAD/__VERBATIM must evaluate to bytes (e.g. __FUNC_SIG, __BYTES).
builtin_function_call = {
    ("__FUNC_SIG" | "__EVENT_HASH" | "__ERROR") ~ "(" ~ (string_literal | identifier) ~ ")"
    | ("__tablesize" | "__tablestart" | "__codesize" | "__EMBED_TABLE") ~ "(" ~ identifier ~ ")"
    | ("__RIGHTPAD" | "__LEFTPAD" | "__VERBATIM") ~ "(" ~ (hex_literal | constant_reference | builtin_function_call) ~ ")"
    | "__BYTES" ~ "(" ~ (string_literal | constant_reference) ~ ")"
    | "__ASSERT_PC" ~ "(" ~ (hex_literal | constant_reference) ~ ")"
    | "__CODECOPY_DYN_ARG" ~ "(" ~ hex_literal ~ "," ~ hex_literal ~ ")"
}

// Reserved builtin names (same set as builtin_function_call); they are never labels or macros
builtin_name = @{
    ( "__FUNC_SIG" | "__EVENT_HASH" | "__ERROR" | "__tablesize" | "__tablestart" | "__codesize"
    | "__EMBED_TABLE" | "__RIGHTPAD" | "__LEFTPAD" | "__VERBATIM" | "__BYTES" | "__ASSERT_PC"
    | "__CODECOPY_DYN_ARG"
    ) ~ !ident_char
}

// ============================================================================
// COMPILE-TIME CONTROL FLOW
// ============================================================================

// For loop, unrolled at compile time. The range end is exclusive; step defaults to 1.
// Inside the body, the loop variable <i> is usable wherever a compile-time value is accepted:
// as a statement, in expressions, as a macro argument, and as an opcode operand.
// Examples:
//   for (i in 0..10) { <i> 0x00 mstore }
//   for (i in 0..5 step 2) { ... }
//   for (i in [BASE]..([BASE] + <offset>)) { ... }
for_loop = { "for" ~ "(" ~ identifier ~ "in" ~ expression ~ ".." ~ expression ~ ("step" ~ expression)? ~ ")" ~ block }

// Conditional compilation; only the selected branch is emitted.
// Examples:
//   if (true) { ... }
//   if ([A] == [B]) { ... } else { ... }
//   if ([MODE] == 1) { ... } else if ([MODE] == 2) { ... } else { ... }
//   if (<threshold> == 0x01) { ... }
if_statement = { "if" ~ "(" ~ expression ~ ")" ~ block ~ ("else" ~ (if_statement | block))? }

// ============================================================================
// LITERALS AND IDENTIFIERS
// ============================================================================

// Names of macros, constants, labels, etc. (MAIN, CONSTRUCTOR and FALLBACK are ordinary names)
// Examples: my_macro, MAIN, _helper, value123
identifier = @{ (ASCII_ALPHA | "_") ~ ident_char* }

boolean_literal = @{ ("true" | "false") ~ !ident_char }

// Examples: 0x42, 0xFF, 0x1234567890abcdef
hex_literal = @{ "0x" ~ ASCII_HEX_DIGIT+ }

// Examples: 0, 42, 256
decimal_literal = @{ ASCII_DIGIT+ }

// Single- or double-quoted, without escape sequences; a string ends at the first quote of
// either kind.
// Examples: "hello", 'transfer(address,uint256)'
string_literal = @{ "\"" ~ (!("\"" | "'") ~ ANY)* ~ "\"" | "'" ~ (!("\"" | "'") ~ ANY)* ~ "'" }
